{
  "description": "game-studio safety reminders. Hooks are advisory: they add a warning or reminder and never block, except the delegation check when the enforce_delegation option is set to block.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/engine-cap.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit)$|^mcp__.+__(write|create|update|edit|delete|remove|set|put|insert|upload|move|rename|execute|apply|import|export|generate|download|batch|send|post)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/delegate-check.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/worker-review.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
